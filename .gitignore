# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/*/node_modules
node_modules
/*/dist

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# VSCode
.vscode

# .lock files
bun.lock
pnpm-lock.yaml

# Devenv
.devenv/
.devenv*
.devenv.flake.nix
devenv.local.nix
devenv.local.yaml
result
result-*

# AI (generated by scottylabs devenv if enabled)
.claude/
.mcp.json

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
